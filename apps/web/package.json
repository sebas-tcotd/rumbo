{
  "name": "race-lab-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build ../../crates/sim-wasm --target web --release --out-dir pkg",
    "dev": "npm run wasm && vite",
    "dev:web": "vite",
    "build": "npm run wasm && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "verify-golden": "npm run wasm && node ../../scripts/verify-golden.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  }
}
