    {
      "includes": [
        "packages/contracts/**/*.{ts,tsx}"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "react",
                      "react/**",
                      "react-dom",
                      "react-dom/**",
                      "three",
                      "three/**"
                    ],
                    "message": "ADR-005: no UI or render libraries here; expose behavior through a port in @rumbo/contracts."
                  },
                  {
                    "group": [
                      "@rumbo/**"
                    ],
                    "message": "ADR-005: contracts imports no other @rumbo package; invert the dependency through a port declared here."
                  },
                  {
                    "group": [
                      "../**"
                    ],
                    "message": "ADR-005: no relative escapes out of the package; import its public entry point."
                  },
                  {
                    "group": [
                      "**/*.wasm"
                    ],
                    "message": "ADR-005: WASM is loaded only inside the adapter through @rumbo/sim-wasm."
                  }
                ]
              }
            }
          }
        }
      }
    },
