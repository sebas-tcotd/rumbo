{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "composite": true,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.json"],
  "exclude": ["dist", "node_modules", "package.json", "tsconfig.json"],
  "references": [{ "path": "../contracts" }]
}
