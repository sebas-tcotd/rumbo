{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "remoteCache": { "enabled": false },
  "globalPassThroughEnv": ["CARGO_HOME", "RUSTUP_HOME", "RUSTUP_TOOLCHAIN", "USERPROFILE", "LOCALAPPDATA", "APPDATA"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "@rumbo/sim-wasm#build": {
      "inputs": [
        "$TURBO_ROOT$/crates/**",
        "!$TURBO_ROOT$/crates/sim-wasm/pkg/**",
        "!$TURBO_ROOT$/crates/*/.turbo/**",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/rust-toolchain.toml"
      ],
      "outputs": ["pkg/**"]
    },
    "typecheck": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"] },
    "//#test": {
      "inputs": ["crates/**", "!crates/sim-wasm/pkg/**", "!crates/*/.turbo/**", "Cargo.lock", "Cargo.toml", "rust-toolchain.toml", "assets/**", "data/**"]
    },
    "dev": { "dependsOn": ["^build"], "cache": false, "persistent": true }
  }
}
